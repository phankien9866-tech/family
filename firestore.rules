rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Courts collection allows public read and write (since admin writes directly from client)
    match /courts/{courtId} {
      allow read, write: if true;
    }

    // Bookings collection allows public read and write for clients to place and view bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Config collection allows public read and write for system config updates
    match /config/{configId} {
      allow read, write: if true;
    }
  }
}
